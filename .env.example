# Copy to .env (gitignored) and fill in. Names only here: real values never go in this file.

# Claude: the agents run on it through the Claude Agent SDK. Not needed with `run --offline`.
ANTHROPIC_API_KEY=

# AgentTrace: Connect your agents > Make a key. "Send runs" for run.py, "Run forks" for worker.py.
AGENTTRACE_API_URL=
AGENTTRACE_INGEST_KEY=
AGENTTRACE_WORKER_KEY=

# How many fork jobs the worker runs at once (1 to 6, default 3). Each starts a Claude process: keep it low on a small laptop.
WORKER_JOBS_AT_ONCE=3

# Which built-in account to write a brief for (acct-1 has 40 tickets and shows the bug; acct-2 is small)
DEMO_ACCOUNT_ID=acct-1
